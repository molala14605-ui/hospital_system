# Copy to `.env` and adjust values.

APP_NAME=Hospital Appointment System
SECRET_KEY=replace-with-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite (local dev)
DATABASE_URL=sqlite:///./hospital.db

# Example PostgreSQL
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/hospital

REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
CACHE_TTL_SECONDS=300

BOOTSTRAP_ADMIN_EMAIL=admin@hospital.example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin123!

# Demo doctor & patient (created on startup if missing — for /ui testing)
BOOTSTRAP_DEMO_DOCTOR_EMAIL=doctor.demo@hospital.example.com
BOOTSTRAP_DEMO_DOCTOR_PASSWORD=Doctor123!
BOOTSTRAP_DEMO_DOCTOR_FULL_NAME=د. تجريبي

BOOTSTRAP_DEMO_PATIENT_EMAIL=patient.demo@hospital.example.com
BOOTSTRAP_DEMO_PATIENT_PASSWORD=Patient123!
BOOTSTRAP_DEMO_PATIENT_FULL_NAME=مريض تجريبي

# Booking rules & pagination (optional overrides)
MIN_APPOINTMENT_MINUTES=15
MAX_APPOINTMENT_HOURS=12
BOOKING_PAST_GRACE_SECONDS=60
APPOINTMENTS_DEFAULT_PAGE_SIZE=20
APPOINTMENTS_MAX_PAGE_SIZE=100
